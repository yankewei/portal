---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import config from "@/config";

const app = {
  name: 'QDII Watch',
  platform: 'Web',
  category: 'Investment Tool',
  description: '监控中国大陆纳斯达克100 ETF联接基金（QDII）的申购限额情况。',
  detail: 'QDII Watch 实时追踪主流纳斯达克100指数场外联接基金的申购状态，帮助投资者快速了解限额变化，支持筛选、排序与搜索。',
  icon: '/image/apps/qdii-watch.png',
  url: 'https://qdii-watch.yankewei.site/',
  features: [
    '实时展示 17 只主要纳斯达克100指数场外联接基金的申购状态',
    '支持按状态筛选：开放申购、限额、暂停申购',
    '支持按日累计限额金额排序',
    '支持搜索基金名称、代码、基金公司',
    '移动优先的响应式设计',
  ],
  dataSource: '天天基金网',
  updateFrequency: '每 4 小时自动更新（GitHub Actions）',
  stack: ['Vanilla JS', 'Cloudflare Workers', 'GitHub Actions'],
};
---

<Layout
  title={`${app.name} | ${config.site.title}`}
  description={app.detail}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={app.name}>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
      <img
        src={app.icon}
        alt={`${app.name} icon`}
        width="96"
        height="96"
        class="h-24 w-24 rounded-2xl"
      />
      <div>
        <p class="text-muted-foreground text-sm">
          {app.platform} · {app.category}
        </p>
        <p class="mt-3 text-lg text-foreground/90">{app.detail}</p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href={app.url}
            target="_blank"
            rel="noreferrer"
            class="bg-accent text-accent-foreground hover:bg-accent/90 inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm font-medium transition-colors"
          >
            访问网站 ↗
          </a>
          <span class="text-muted-foreground text-sm">
            免费使用，无需注册
          </span>
        </div>
      </div>
    </div>

    <hr class="border-border my-8" />

    <h2 class="text-xl font-semibold">核心功能</h2>
    <ul class="mt-4 space-y-3">
      {app.features.map((feature, index) => (
        <li class="flex gap-3">
          <span class="text-accent text-sm font-mono">{String(index + 1).padStart(2, '0')}</span>
          <span class="text-foreground/80 text-sm">{feature}</span>
        </li>
      ))}
    </ul>

    <hr class="border-border my-8" />

    <h2 class="text-xl font-semibold">技术说明</h2>
    <div class="mt-4 space-y-3 text-sm text-foreground/80">
      <p>
        <span class="text-muted-foreground">数据源：</span>
        {app.dataSource} 公开信息
      </p>
      <p>
        <span class="text-muted-foreground">更新频率：</span>
        {app.updateFrequency}
      </p>
      <p>
        <span class="text-muted-foreground">技术栈：</span>
        {app.stack.join(' · ')}
      </p>
    </div>

    <hr class="border-border my-8" />

    <h2 class="text-xl font-semibold">监控基金列表</h2>
    <p class="mt-2 text-sm text-foreground/70">
      当前覆盖 17 只主要纳斯达克100 ETF联接基金，包括广发、华安、天弘、嘉实、大成、国泰、南方、招商、博时、建信、华泰柏瑞、易方达、汇添富、摩根、宝盈、万家、华夏等基金公司产品。
    </p>

    <hr class="border-border my-8" />

    <div class="rounded-md border border-border bg-muted/40 p-4">
      <p class="text-sm text-foreground/70">
        <span class="font-medium text-foreground/90">免责声明：</span>
        数据来源于天天基金网公开信息，仅供参考，不构成投资建议。投资有风险，入市需谨慎。
      </p>
    </div>

    <hr class="border-border my-8" />

    <p class="text-sm text-foreground/60">
      问题反馈或建议：
      <a href="mailto:yankewei1993@gmail.com?subject=QDII%20Watch%20Feedback" class="text-accent hover:underline">
        yankewei1993@gmail.com
      </a>
    </p>
  </Main>
  <Footer />
</Layout>
