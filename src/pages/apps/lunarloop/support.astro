---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import config from "@/config";

const supportEmail = "yankewei1993@gmail.com";
const appStoreURL = "https://apps.apple.com/app/id6747391274";
const emailURL = `mailto:${supportEmail}?subject=${encodeURIComponent("日月有期 · 技术支持")}&body=${encodeURIComponent("你好，\n\n我在使用日月有期时遇到了以下问题：\n\nApp 版本：\niPhone 型号：\niOS 版本：\n问题描述与复现步骤：\n\n")}`;

const troubleshooting = [
  {
    number: "01",
    title: "没有收到提醒",
    description:
      "前往系统“设置”检查通知权限，并确认事件至少选择了当天、提前 3 天或提前 7 天中的一种提醒。",
  },
  {
    number: "02",
    title: "看不到系统日历",
    description:
      "在 App 的“设置”中打开系统日历权限。若曾拒绝授权，请前往 iOS 系统设置重新允许完整访问。",
  },
  {
    number: "03",
    title: "需要清除数据",
    description:
      "打开 App 的“设置”，在“数据”下选择“删除全部事件”。删除后无法恢复，请先确认不再需要这些记录。",
  },
];

const faqs = [
  {
    question: "日月有期支持哪些日期和提醒方式？",
    answer:
      "你可以创建农历或公历事件，设置不重复或每年重复，并选择当天、提前 3 天和提前 7 天提醒。提醒由 iOS 在设备本地安排。",
  },
  {
    question: "农历闰月如何处理？",
    answer:
      "当前版本会将农历闰月按普通月份处理。如果你的纪念日与闰月严格相关，建议在对应年份确认下一次日期。",
  },
  {
    question: "为什么桌面小组件没有显示系统日历事件？",
    answer:
      "请确认已经授予完整日历访问权限，并在添加权限后稍候让小组件刷新。你也可以移除小组件后重新添加。",
  },
  {
    question: "更换设备后，事件会自动同步吗？",
    answer:
      "当前版本的自定义事件保存在本机，不会自动同步到其他设备。卸载 App 前请确认你不再需要其中的记录。",
  },
  {
    question: "联系支持时需要提供什么？",
    answer:
      "请附上 App 版本、iPhone 型号、iOS 版本、复现步骤和必要的截图。请勿在邮件中发送生日、纪念日等不必要的私人信息。",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "日月有期技术支持",
  description:
    "日月有期 iOS App 的使用帮助、常见问题、隐私说明与技术支持联系方式。",
  url: new URL("apps/lunarloop/support/", config.site.url).href,
  about: {
    "@type": "SoftwareApplication",
    name: "日月有期",
    operatingSystem: "iOS",
    applicationCategory: "UtilitiesApplication",
    downloadUrl: appStoreURL,
  },
};
---

<Layout
  title={`日月有期技术支持 | ${config.site.title}`}
  description="日月有期 iOS App 的使用帮助、常见问题、隐私说明与技术支持联系方式。"
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />

  <Header />

  <main id="main-content" class="support-page app-layout pb-16">
    <nav class="support-breadcrumb" aria-label="面包屑导航">
      <a href="/apps">Apps</a>
      <span aria-hidden="true">/</span>
      <a href="/apps/lunarloop">日月有期</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">技术支持</span>
    </nav>

    <section class="support-hero" aria-labelledby="support-title">
      <div class="hero-copy">
        <p class="eyebrow">LUNARLOOP · iOS SUPPORT</p>
        <h1 id="support-title">重要日子，<br />别让问题耽误提醒。</h1>
        <p class="hero-description">
          “日月有期”同时支持农历与公历倒数。这里汇集使用帮助、隐私说明，以及可以直接联系开发者的方式。
        </p>
        <div class="hero-actions">
          <a class="primary-action" href={emailURL}>发送支持邮件</a>
          <a
            class="secondary-action"
            href={appStoreURL}
            target="_blank"
            rel="noreferrer"
          >
            在 App Store 查看 ↗
          </a>
        </div>
      </div>

      <div class="calendar-art" aria-hidden="true">
        <div class="calendar-page">
          <span class="binding binding-left"></span>
          <span class="binding binding-right"></span>
          <svg viewBox="0 0 180 180" role="presentation">
            <circle cx="91" cy="90" r="54" class="moon-disc"></circle>
            <circle cx="116" cy="70" r="54" class="moon-cutout"></circle>
            <circle cx="126" cy="67" r="13" class="moon-dot"></circle>
          </svg>
          <div class="calendar-caption">
            <span>农历</span>
            <strong>十五</strong>
          </div>
        </div>
        <span class="orbit orbit-one"></span>
        <span class="orbit orbit-two"></span>
      </div>
    </section>

    <aside class="contact-strip" aria-label="支持联系方式">
      <div>
        <span class="contact-label">开发者</span>
        <strong>Kewei Yan</strong>
      </div>
      <div>
        <span class="contact-label">支持邮箱</span>
        <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
      </div>
      <div>
        <span class="contact-label">支持语言</span>
        <strong>简体中文 · English</strong>
      </div>
    </aside>

    <section class="support-section" aria-labelledby="quick-help-title">
      <div class="section-heading">
        <p class="section-index">01 / QUICK HELP</p>
        <h2 id="quick-help-title">先试试这些</h2>
        <p>多数权限与显示问题，可以通过下面三步快速解决。</p>
      </div>

      <ol class="help-grid">
        {
          troubleshooting.map(item => (
            <li class="help-card">
              <span class="help-number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="support-section faq-section" aria-labelledby="faq-title">
      <div class="section-heading">
        <p class="section-index">02 / FAQ</p>
        <h2 id="faq-title">常见问题</h2>
        <p>点击问题展开答案。</p>
      </div>

      <div class="faq-list">
        {
          faqs.map((faq, index) => (
            <details>
              <summary>
                <span class="faq-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{faq.question}</span>
                <span class="faq-toggle" aria-hidden="true" />
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section
      id="privacy"
      class="support-section privacy-section"
      aria-labelledby="privacy-title"
    >
      <div class="section-heading">
        <p class="section-index">03 / PRIVACY</p>
        <h2 id="privacy-title">你的日期，留在你的设备上</h2>
      </div>

      <div class="privacy-layout">
        <p class="privacy-lead">
          日月有期不收集、不出售，也不与开发者服务器共享你的个人数据。
        </p>
        <ul>
          <li>
            <strong>自定义事件</strong>
            <span>保存在本机，仅与 App 的桌面小组件在设备上共享。</span>
          </li>
          <li>
            <strong>系统日历</strong>
            <span>仅在获得授权后于设备上读取和展示，不会上传。</span>
          </li>
          <li>
            <strong>通知</strong>
            <span>由 iOS 在本地安排和发送，无需开发者服务器参与。</span>
          </li>
        </ul>
      </div>
      <p class="privacy-updated">隐私说明更新于 2026 年 7 月 29 日</p>
    </section>

    <section class="contact-card" aria-labelledby="contact-title">
      <div>
        <p class="section-index">NEED MORE HELP?</p>
        <h2 id="contact-title">还没有解决？写信给我。</h2>
        <p>
          邮件模板会提醒你附上版本与设备信息，帮助我更快定位问题。也欢迎发送建议或功能需求。
        </p>
      </div>
      <a href={emailURL}>
        <span>联系技术支持</span>
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .support-page {
    --lunar-red: #a64b3f;
    --lunar-red-deep: #773229;
    --lunar-paper: #f7f3ea;
    --lunar-paper-deep: #eee8dc;
    --lunar-ink: #28231f;
    --lunar-muted: #736e66;
    --lunar-line: rgb(54 50 45 / 14%);
    --lunar-white: #fcfaf6;
    color: var(--lunar-ink);
  }

  :global([data-theme="dark"]) .support-page {
    --lunar-red: #d18273;
    --lunar-red-deep: #edaa9d;
    --lunar-paper: #24211d;
    --lunar-paper-deep: #302b26;
    --lunar-ink: #f5f0e8;
    --lunar-muted: rgb(255 255 255 / 64%);
    --lunar-line: rgb(255 255 255 / 12%);
    --lunar-white: #36312b;
  }

  .support-breadcrumb {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-block: 2rem 0.75rem;
    color: var(--lunar-muted);
    font-size: 0.75rem;
  }

  .support-breadcrumb a {
    color: var(--lunar-red);
  }

  .support-breadcrumb a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .support-hero {
    position: relative;
    isolation: isolate;
    min-height: 31rem;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    align-items: center;
    gap: 2rem;
    padding: clamp(2rem, 6vw, 4.5rem);
    border: 1px solid var(--lunar-line);
    border-radius: 1.5rem;
    background:
      linear-gradient(115deg, rgb(255 255 255 / 34%), transparent 45%),
      var(--lunar-paper);
  }

  .support-hero::before {
    position: absolute;
    z-index: -1;
    right: -7rem;
    bottom: -10rem;
    width: 27rem;
    height: 27rem;
    border: 1px solid color-mix(in srgb, var(--lunar-red) 22%, transparent);
    border-radius: 50%;
    content: "";
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .eyebrow,
  .section-index {
    color: var(--lunar-red);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .support-hero h1 {
    max-width: 12ch;
    margin-top: 1.1rem;
    font-size: clamp(2.35rem, 5vw, 3.7rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.06;
  }

  .hero-description {
    max-width: 35rem;
    margin-top: 1.5rem;
    color: var(--lunar-muted);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-actions a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding-inline: 1.1rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .hero-actions a:hover {
    transform: translateY(-2px);
  }

  .primary-action {
    background: var(--lunar-red);
    color: #fffaf4;
    box-shadow: 0 0.8rem 2rem
      color-mix(in srgb, var(--lunar-red) 24%, transparent);
  }

  .primary-action:hover {
    background: var(--lunar-red-deep);
  }

  .secondary-action {
    border: 1px solid var(--lunar-line);
    background: color-mix(in srgb, var(--lunar-white) 76%, transparent);
    color: var(--lunar-ink);
  }

  .calendar-art {
    position: relative;
    min-height: 21rem;
    display: grid;
    place-items: center;
  }

  .calendar-page {
    position: relative;
    z-index: 2;
    width: min(100%, 17.5rem);
    aspect-ratio: 0.9;
    padding: 2.25rem 1.4rem 1.25rem;
    overflow: hidden;
    border-radius: 2.5rem 2.5rem 4rem 2.5rem;
    background: var(--lunar-red);
    color: #fffaf4;
    box-shadow:
      0 2rem 4rem color-mix(in srgb, var(--lunar-red-deep) 30%, transparent),
      inset 0 1px rgb(255 255 255 / 28%);
    transform: rotate(3deg);
  }

  .calendar-page::after {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 2.4rem 0 0;
    background: color-mix(in srgb, #fff 65%, var(--lunar-red));
    content: "";
    opacity: 0.78;
  }

  .binding {
    position: absolute;
    top: -0.65rem;
    width: 1.55rem;
    height: 2.4rem;
    border-radius: 999px;
    background: var(--lunar-red-deep);
  }

  .binding-left {
    left: 3.4rem;
  }

  .binding-right {
    right: 3.4rem;
  }

  .calendar-page svg {
    width: 100%;
    height: auto;
  }

  .moon-disc {
    fill: #fffaf4;
  }

  .moon-cutout {
    fill: var(--lunar-red);
  }

  .moon-dot {
    fill: #2a241f;
  }

  .calendar-caption {
    position: absolute;
    bottom: 1.25rem;
    left: 1.4rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .calendar-caption span {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
  }

  .calendar-caption strong {
    font-size: 1.1rem;
  }

  .orbit {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--lunar-red) 35%, transparent);
    border-radius: 50%;
  }

  .orbit-one {
    width: 21rem;
    height: 12rem;
    transform: rotate(-24deg);
  }

  .orbit-two {
    width: 14rem;
    height: 22rem;
    transform: rotate(34deg);
  }

  .contact-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-right: 1px solid var(--lunar-line);
    border-bottom: 1px solid var(--lunar-line);
    border-left: 1px solid var(--lunar-line);
  }

  .contact-strip > div {
    min-width: 0;
    padding: 1.25rem 1.5rem;
  }

  .contact-strip > div + div {
    border-left: 1px solid var(--lunar-line);
  }

  .contact-label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--lunar-muted);
    font-size: 0.65rem;
  }

  .contact-strip strong,
  .contact-strip a {
    display: block;
    overflow: hidden;
    color: var(--lunar-ink);
    font-size: 0.76rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-strip a:hover {
    color: var(--lunar-red);
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .support-section {
    padding-block: clamp(4.5rem, 10vw, 7rem);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.65fr);
    gap: 0.75rem 2rem;
    align-items: end;
    margin-bottom: 2.25rem;
  }

  .section-heading .section-index {
    grid-column: 1 / -1;
  }

  .section-heading h2,
  .contact-card h2 {
    font-size: clamp(1.7rem, 5vw, 2.65rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .section-heading > p:last-child {
    color: var(--lunar-muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--lunar-line);
    border-left: 1px solid var(--lunar-line);
  }

  .help-card {
    min-height: 15rem;
    padding: 1.5rem;
    border-right: 1px solid var(--lunar-line);
    border-bottom: 1px solid var(--lunar-line);
    background: color-mix(in srgb, var(--lunar-paper) 52%, transparent);
  }

  .help-number,
  .faq-number {
    color: var(--lunar-red);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .help-card h3 {
    margin-top: 3.75rem;
    font-size: 1rem;
    font-weight: 700;
  }

  .help-card p {
    margin-top: 0.75rem;
    color: var(--lunar-muted);
    font-size: 0.76rem;
    line-height: 1.75;
  }

  .faq-section {
    border-top: 1px solid var(--lunar-line);
  }

  .faq-list {
    border-top: 1px solid var(--lunar-line);
  }

  .faq-list details {
    border-bottom: 1px solid var(--lunar-line);
  }

  .faq-list summary {
    display: grid;
    grid-template-columns: 2rem 1fr 1.5rem;
    gap: 0.75rem;
    align-items: center;
    padding-block: 1.35rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-toggle {
    position: relative;
    width: 1rem;
    height: 1rem;
  }

  .faq-toggle::before,
  .faq-toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.8rem;
    height: 1px;
    background: var(--lunar-red);
    content: "";
    transition: transform 180ms ease;
    transform: translate(-50%, -50%);
  }

  .faq-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] .faq-toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-list details > p {
    max-width: 38rem;
    padding: 0 1.5rem 1.5rem 2.75rem;
    color: var(--lunar-muted);
    font-size: 0.78rem;
    line-height: 1.8;
  }

  .privacy-section {
    margin-inline: calc(50% - 50vw);
    padding-inline: max(1rem, calc((100vw - 48rem) / 2));
    background: var(--lunar-paper);
  }

  .privacy-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 7vw, 5rem);
  }

  .privacy-lead {
    color: var(--lunar-red-deep);
    font-size: clamp(1.15rem, 3vw, 1.65rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.5;
  }

  .privacy-layout ul {
    border-top: 1px solid var(--lunar-line);
  }

  .privacy-layout li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--lunar-line);
    font-size: 0.75rem;
    line-height: 1.7;
  }

  .privacy-layout li span {
    color: var(--lunar-muted);
  }

  .privacy-updated {
    margin-top: 2rem;
    color: var(--lunar-muted);
    font-size: 0.65rem;
  }

  .contact-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
    margin-top: clamp(4.5rem, 10vw, 7rem);
    padding: clamp(1.5rem, 5vw, 3rem);
    border-radius: 1.25rem;
    background: var(--lunar-ink);
    color: var(--lunar-paper);
  }

  .contact-card h2 {
    max-width: 15ch;
    margin-top: 0.75rem;
  }

  .contact-card p:not(.section-index) {
    max-width: 35rem;
    margin-top: 1rem;
    color: color-mix(in srgb, var(--lunar-paper) 68%, transparent);
    font-size: 0.75rem;
    line-height: 1.7;
  }

  .contact-card > a {
    display: flex;
    min-width: 12rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--lunar-paper) 30%, transparent);
    border-radius: 999px;
    color: var(--lunar-paper);
    font-size: 0.75rem;
    font-weight: 700;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .contact-card > a:hover {
    border-color: var(--lunar-red);
    background: color-mix(in srgb, var(--lunar-red) 18%, transparent);
  }

  @media (max-width: 700px) {
    .support-hero {
      min-height: auto;
      grid-template-columns: 1fr;
      padding: 2rem 1.35rem 2.5rem;
    }

    .calendar-art {
      min-height: 17rem;
      order: -1;
    }

    .calendar-page {
      width: 13.5rem;
    }

    .orbit-one {
      width: 17rem;
    }

    .orbit-two {
      height: 17rem;
    }

    .contact-strip,
    .section-heading,
    .help-grid,
    .privacy-layout,
    .contact-card {
